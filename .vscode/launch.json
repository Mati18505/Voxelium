{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug executable 'client'",
      "type": "codelldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/client",
      "env": {
        "BEVY_ASSET_ROOT": "${workspaceFolder}/client", 
        "LD_LIBRARY_PATH": "${workspaceFolder}/target/debug/deps:${env:HOME}/.rustup/toolchains/stable-x86_64-unknown-linux-gnu/lib/rustlib/x86_64-unknown-linux-gnu/lib"
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopOnEntry": false
    }
  ]
}
